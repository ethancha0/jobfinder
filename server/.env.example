## Local database connection string for SQLAlchemy
# Example (Homebrew Postgres on port 5433, usually no password locally):
# DATABASE_URL=postgresql://ethanchao@localhost:5433/jobfinder

# If you're using a password-authenticated server on 5432 instead:
# DATABASE_URL=postgresql://ethanchao:YOUR_PASSWORD@localhost:5432/jobfinder

## Optional: seed jobs at API startup (helps /greenhouse/queryjobs in production)
# SEED_JOBS_ON_STARTUP=1
# SEED_JOBS_DAYS=14

